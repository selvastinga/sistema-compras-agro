{
  "name": "sistema-compras-agro",
  "version": "1.0.0",
  "description": "Sistema de Pedidos de Compras y Control Presupuestario - Depto. Ciencias Agropecuarias (FICA - UNSL)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:server": "cd server && node index.js",
